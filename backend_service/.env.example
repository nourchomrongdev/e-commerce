DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/digital_product
JWT_SECRET=replace-with-a-long-random-secret
FILE_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PORT=5000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_REDIRECT_URL=http://localhost:5000/api/auth/paypal/callback
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_ENVIRONMENT=sandbox
# PayPal payouts are disabled until explicitly enabled with approved credentials.
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_PAYOUTS_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_PAYOUT_ENCRYPTION_KEY=generate-a-long-random-secret-for-payout-account-encryption
# Set true only when Advanced Card Payments is enabled for this PayPal Sandbox app.
PAYPAL_ADVANCED_CARD_PAYMENTS_ENABLED=false
PAYPAL_RETURN_URL=http://localhost:3000/cart/payment?paypal=return
PAYPAL_CANCEL_URL=http://localhost:3000/cart/payment?paypal=cancelled
PAYWAY_ENVIRONMENT=sandbox
PAYWAY_LIFETIME_MINUTES=5
ABAPAYWAY_MERCHANT_ID=your-sandbox-merchant-id
ABAPAYWAY_API_KEY=your-sandbox-api-key
ABAPAYWAY_SECRET_KEY=your-sandbox-secret-key
ABAPAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
PAYWAY_NOTIFY_URL=https://your-public-backend.example/api/payments/payway/capture
PAYWAY_SUCCESS_URL=http://localhost:3000/cart/payment
PAYWAY_CANCEL_URL=http://localhost:3000/cart/payment
